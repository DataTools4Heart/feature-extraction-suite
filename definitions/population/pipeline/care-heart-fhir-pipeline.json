{
  "id": "care_heart_cohort",
  "resourceType": "PopulationPipeline",
  "url": "https://ai4hf.eu/cohorts/care_heart",
  "name": "care_heart_cohort",
  "title": "Adult Patients with Cardiology Encounters (Inpatient or Outpatient) After First Heart Failure Diagnosis",
  "description": "This cohort includes cardiology-related inpatient admissions and outpatient visits of patients with heart failure who were 18 years or older at their first heart failure diagnosis. Patients first diagnosed with heart failure before the age of 18 are excluded entirely. An encounter is included when the patient's first heart failure diagnosis occurred on or before the encounter reference time: the discharge date for inpatient admissions and the visit date for outpatient visits.",
  "version": "1.4",
  "date": "2026-11-04",
  "status": "active",
  "publisher": "DataTools4Heart/AI4HF Team (SRDC Corp.)",
  "interface": "fhir",
  "supportedVersions": [
    "R5"
  ],
  "entry": [
    {
      "name": "patientEncounter",
      "description": "Includes inpatient and outpatient hospital encounters associated with cardiology services.",
      "resourceType": "Encounter",
      "query": "?service-type=http://snomed.info/sct|394579002&class=AMB,IMP",
      "entityLink": [
        {
          "entity": "pid",
          "entityType": "Patient",
          "searchParam": "patient",
          "path": "subject.reference"
        },
        {
          "entity": "encounterId",
          "entityType": "Encounter",
          "searchParam": "_id",
          "path": "id"
        }
      ],
      "eventTime": "Encounter.actualPeriod.start",
      "exitTime": "iif(Encounter.class.coding.where(system='http://terminology.hl7.org/CodeSystem/v3-ActCode' and code='IMP').exists(), Encounter.actualPeriod.end, Encounter.actualPeriod.start)"
    }
  ],
  "eligibility": [
    {
      "name": "adultsWithHeartFailure",
      "description": "Restricts the cohort to patients whose first heart failure diagnosis occurred when they were 18 years or older, and to their encounters whose reference time (discharge date for inpatient encounters, visit date for outpatient encounters) is on or after that first heart failure diagnosis.",
      "criteria": [
        {
          "resourceType": "Condition",
          "category": "exclusion",
          "query": "?code:below=http://hl7.org/fhir/sid/icd-10|I50,http://hl7.org/fhir/sid/icd-10|I11.0,http://hl7.org/fhir/sid/icd-10|I13.0,http://hl7.org/fhir/sid/icd-10|I13.2,http://hl7.org/fhir/sid/icd-10|I09.81,http://hl7.org/fhir/sid/icd-10|I97.13,http://hl7.org/fhir/sid/icd-10|I25.5&_include=Condition:subject:Patient",
          "entityLink": [
            {
              "entity": "pid",
              "entityType": "Patient",
              "searchParam": "patient",
              "path": "Condition.subject.reference"
            }
          ],
          "filter": "onsetDateTime.toDateTime() < (_includedPatient.birthDate.toDate().toDateTime() + 18 years)"
        },
        {
          "resourceType": "Condition",
          "category": "inclusion",
          "query": "?code:below=http://hl7.org/fhir/sid/icd-10|I50,http://hl7.org/fhir/sid/icd-10|I11.0,http://hl7.org/fhir/sid/icd-10|I13.0,http://hl7.org/fhir/sid/icd-10|I13.2,http://hl7.org/fhir/sid/icd-10|I09.81,http://hl7.org/fhir/sid/icd-10|I97.13,http://hl7.org/fhir/sid/icd-10|I25.5",
          "entityLink": [
            {
              "entity": "pid",
              "entityType": "Patient",
              "searchParam": "patient",
              "path": "Condition.subject.reference"
            }
          ],
          "eventTime": "Condition.onsetDateTime",
          "timeConstraint": {
            "searchParam": "onset-date",
            "path": "Condition.onsetDateTime",
            "end": "%eligibilityExitTime"
          }
        }
      ]
    }
  ]
}
