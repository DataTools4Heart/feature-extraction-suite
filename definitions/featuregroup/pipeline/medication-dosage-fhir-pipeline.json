{
  "id": "medication_dosage",
  "resourceType": "FeatureGroupPipeline",
  "url": "https://datatools4heart.eu/feature-groups/medication_dosage",
  "name": "medication_dosage",
  "title": "Medication requests with their daily dose",
  "description": "Heart failure related drug prescriptions (MedicationRequest only) together with the dosage fields and the daily dose calculated from them, with the dosing start time shifted 1 day earlier so that prescriptions registered up to 1 day after discharge still fall inside the feature window",
  "version": "1.0",
  "status": "active",
  "date": "2026-09-28",
  "publisher": "DataTools4Heart/AI4HF Team (SRDC Corp.)",
  "interface": "fhir",
  "supportedVersions": [
    "R5"
  ],
  "pipeline": [
    {
      "description": "Extract the heart failure related drug prescriptions and their dosage from MedicationRequest. Only the first dosage instruction and its first dose are used.",
      "resourceType": "MedicationRequest",
      "targetProfile": "https://datatools4heart.eu/fhir/StructureDefinition/HFR-MedicationRequest",
      "query": "?code:below=http://www.whocc.no/atc|A10BD,http://www.whocc.no/atc|A10BK,http://www.whocc.no/atc|C01AA,http://www.whocc.no/atc|C01DA,http://www.whocc.no/atc|C01DX,http://www.whocc.no/atc|C01EB,http://www.whocc.no/atc|C02DB,http://www.whocc.no/atc|C02LG,http://www.whocc.no/atc|C03,http://www.whocc.no/atc|C05AE,http://www.whocc.no/atc|C07,http://www.whocc.no/atc|C09,http://www.whocc.no/atc|C10BX",
      "entityLink": [
        {
          "entity": "pid",
          "entityType": "Patient",
          "searchParam": "patient",
          "path": "MedicationRequest.subject.reference"
        },
        {
          "entity": "encounterId",
          "entityType": "Encounter",
          "searchParam": "encounter",
          "path": "MedicationRequest.encounter.reference"
        }
      ],
      "feature": [
        {
          "name": "medicationCodes",
          "path": "MedicationRequest.medication.concept.coding.where(system='http://www.whocc.no/atc').code"
        },
        {
          "name": "dose",
          "path": "MedicationRequest.dosageInstruction.first().doseAndRate.doseQuantity.value.first()"
        },
        {
          "name": "doseUnit",
          "path": "MedicationRequest.dosageInstruction.first().doseAndRate.doseQuantity.unit.first()"
        },
        {
          "name": "frequency",
          "path": "MedicationRequest.dosageInstruction.first().timing.repeat.frequency"
        },
        {
          "name": "period",
          "path": "MedicationRequest.dosageInstruction.first().timing.repeat.period"
        },
        {
          "name": "periodUnit",
          "path": "MedicationRequest.dosageInstruction.first().timing.repeat.periodUnit"
        },
        {
          "name": "dailyDose",
          "path": "MedicationRequest.dosageInstruction.first().select(iif(doseAndRate.doseQuantity.value.exists(), doseAndRate.doseQuantity.value.first() * iif(timing.repeat.frequency.exists(), timing.repeat.frequency, 1) / (iif(timing.repeat.period.exists(), timing.repeat.period, 1) * iif(timing.repeat.periodUnit.exists(), iif(timing.repeat.periodUnit = 'h', 1.0 / 24, iif(timing.repeat.periodUnit = 'd', 1, iif(timing.repeat.periodUnit = 'wk', 7, iif(timing.repeat.periodUnit = 'mo', 30, iif(timing.repeat.periodUnit = 'a', 365, {}))))), 1))))"
        },
        {
          "name": "startTime",
          "path": "MedicationRequest.effectiveDosePeriod.start.toDateTime()"
        },
        {
          "name": "endTime",
          "path": "MedicationRequest.effectiveDosePeriod.end.toDateTime()"
        },
        {
          "name": "joinTime",
          "path": "MedicationRequest.effectiveDosePeriod.start.toDateTime() - 1 day"
        },
        {
          "name": "joinEndTime",
          "path": "MedicationRequest.effectiveDosePeriod.end.toDateTime() - 1 day"
        }
      ]
    }
  ]
}
