{
  "id": "study3_med_requests",
  "resourceType": "FeatureGroupPipeline",
  "url": "https://datatools4heart.eu/feature-groups/study3_med_requests",
  "name": "study3_med_requests",
  "title": "Medication requests used by the study 3 condition criteria",
  "description": "Blood-glucose-lowering drug prescriptions (ATC A10A and A10B), with the dosing start time shifted 3 days earlier so that prescriptions registered shortly after an outpatient visit still fall inside the feature window",
  "version": "1.0",
  "status": "active",
  "date": "2026-09-24",
  "publisher": "DataTools4Heart/AI4HF Team (SRDC Corp.)",
  "interface": "fhir",
  "supportedVersions": [
    "R5"
  ],
  "pipeline": [
    {
      "description": "Extract the blood-glucose-lowering drug prescriptions used by the study 3 condition criteria from MedicationRequest.",
      "resourceType": "MedicationRequest",
      "targetProfile": "https://datatools4heart.eu/fhir/StructureDefinition/HFR-MedicationRequest",
      "query": "?code:below=http://www.whocc.no/atc|A10A,http://www.whocc.no/atc|A10B",
      "entityLink": [
        {
          "entity": "pid",
          "entityType": "Patient",
          "searchParam": "patient",
          "path": "MedicationRequest.subject.reference"
        },
        {
          "entity": "encounterId",
          "entityType": "Encounter",
          "searchParam": "encounter",
          "path": "MedicationRequest.encounter.reference"
        }
      ],
      "feature": [
        {
          "name": "medicationCodes",
          "path": "MedicationRequest.medication.concept.coding.where(system='http://www.whocc.no/atc').code"
        },
        {
          "name": "medicationGroups",
          "path": "MedicationRequest.medication.concept.coding.where(system='https://datatools4heart.eu/fhir/CodeSystem/medication-group').code"
        },
        {
          "name": "startTime",
          "path": "MedicationRequest.effectiveDosePeriod.start"
        },
        {
          "name": "endTime",
          "path": "MedicationRequest.effectiveDosePeriod.end"
        },
        {
          "name": "joinTime",
          "path": "MedicationRequest.effectiveDosePeriod.start.toDateTime() - 3 days"
        },
        {
          "name": "joinEndTime",
          "path": "MedicationRequest.effectiveDosePeriod.end.toDateTime() - 3 days"
        }
      ]
    }
  ]
}
